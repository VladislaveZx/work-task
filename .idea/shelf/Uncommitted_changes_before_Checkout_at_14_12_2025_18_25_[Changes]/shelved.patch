+package ru.vladislav.bekrenev.ticketapiservice.config.micrometer;
+
+import io.micrometer.core.instrument.Counter;
+import io.micrometer.core.instrument.MeterRegistry;
+import io.micrometer.core.instrument.Timer;
+import jakarta.annotation.PostConstruct;
+import lombok.RequiredArgsConstructor;
+import org.springframework.context.annotation.Scope;
+import org.springframework.stereotype.Component;
+
+@Component
+@RequiredArgsConstructor
+public class MetricConfig {
+
+    public static final String TICKET_API_TICKETS_CREATED_TOTAL = "ticket_api_tickets_created_total";
+    public static final String TICKET_API_DATABASE_SAVE_TIME = "ticket_api_database_save_time";
+    public static final String TICKET_API_KAFKA_MESSAGES_SENT_TOTAL = "ticket_api_kafka_messages_sent_total";
+    public static final String TICKET_API_KAFKA_AVAILABLE = "ticket_api_kafka_available";
+    public static final String TICKET_API_REQUEST_LATENCY = "ticket_api_request_latency";
+    public static final String TICKET_API_TICKETS_NEW_COUNT = "ticket_api_tickets_new_count";
+    public static final String TICKET_API_TICKETS_IN_PROGRESS_COUNT = "ticket_api_tickets_in_progress_count";
+    public static final String TICKET_API_TICKETS_DONE_COUNT = "ticket_api_tickets_done_count";
+    public static final String TICKET_API_TICKETS_REJECTED_COUNT = "ticket_api_tickets_rejected_count";
+
+    private final MeterRegistry meterRegistry;
+
+    // Timers для измерения времени выполнения
+    private Timer ticketApiDatabaseSaveTimer;
+    private Timer ticketApiRequestLatencyTimer;
+
+    // Counters
+    private Counter ticketApiTicketsCreatedCounter;
+    private Counter ticketApiKafkaMessagesSentCounter;
+    private Counter ticketApiKafkaAvailableCounter;
+
+    @PostConstruct
+    public void initMetrics() {
+        // Инициализация таймеров
+        ticketApiDatabaseSaveTimer = Timer.builder(TICKET_API_DATABASE_SAVE_TIME)
+                .description("Time taken to save ticket to database")
+                .publishPercentiles(0.5, 0.95, 0.99)
+                .register(meterRegistry);
+
+        ticketApiRequestLatencyTimer = Timer.builder(TICKET_API_REQUEST_LATENCY)
+                .description("HTTP request latency for ticket operations")
+                .publishPercentiles(0.5, 0.95, 0.99)
+                .register(meterRegistry);
+
+        // Инициализация счетчиков для Ticket API Service
+        ticketApiTicketsCreatedCounter = Counter.builder(TICKET_API_TICKETS_CREATED_TOTAL)
+                .description("Total number of tickets created")
+                .register(meterRegistry);
+
+        ticketApiKafkaMessagesSentCounter = Counter.builder(TICKET_API_KAFKA_MESSAGES_SENT_TOTAL)
+                .description("Total number of Kafka messages sent successfully")
+                .register(meterRegistry);
+
+        ticketApiKafkaAvailableCounter = Counter.builder(TICKET_API_KAFKA_AVAILABLE)
+                .description("Count of Kafka connection errors")
+                .register(meterRegistry);
+
+        // Инициализация gauge для количества тикетов в статусе NEW
+        meterRegistry.gauge(TICKET_API_TICKETS_NEW_COUNT, 0.0);
+        meterRegistry.gauge(TICKET_API_TICKETS_IN_PROGRESS_COUNT, 0.0);
+        meterRegistry.gauge(TICKET_API_TICKETS_DONE_COUNT, 0.0);
+        meterRegistry.gauge(TICKET_API_TICKETS_REJECTED_COUNT, 0.0);
+
+
+
+    }
+
+    // Методы для Ticket API Service
+    public void incrementTicketsCreated() {
+        ticketApiTicketsCreatedCounter.increment();
+    }
+
+    public Timer.Sample startDatabaseSaveTimer() {
+        return Timer.start(meterRegistry);
+    }
+
+    public void recordDatabaseSaveTime(Timer.Sample sample) {
+        sample.stop(ticketApiDatabaseSaveTimer);
+    }
+
+    public void incrementKafkaMessagesSent() {
+        ticketApiKafkaMessagesSentCounter.increment();
+    }
+
+    public void incrementKafkaAvailable() {
+        ticketApiKafkaAvailableCounter.increment();
+    }
+
+    public Timer.Sample startRequestLatencyTimer() {
+        return Timer.start(meterRegistry);
+    }
+
+    public void recordRequestLatency(Timer.Sample sample) {
+        sample.stop(ticketApiRequestLatencyTimer);
+    }
+
+    public void setTicketsNewCount(double count) {
+        meterRegistry.gauge(TICKET_API_TICKETS_NEW_COUNT, count);
+    }
+}
